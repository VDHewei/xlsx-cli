{
  "name": "@vdhewei/bun-webview-cli",
  "version": "1.0.0",
  "description": "bun webview cli",
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv": "npm:dotenv",
    "rcedit": "npm:rcedit"
  },
  "scripts": {
    "build": "bun build --compile --minify --compile-autoload-tsconfig --compile-autoload-package-json ./src/index.ts --outfile bin/webview-cli",
    "compile": "bun run pre-compile && bun run build.ts",
    "pre-compile": "bun run compile-assets",
    "start": "bun run src/index.ts",
    "compile-assets": "bun run scripts/embed-assets.ts",
    "prepublishOnly": "bun run compile-assets",
    "clean": "bun run scripts/clean.ts",
    "test": "bun test"
  },
  "author": "VDHewei@github.io",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "docx": "^9.6.1",
    "webview-bun": "^2.4.0",
    "xlsx": "^0.18.5"
  }
}
